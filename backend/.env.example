# Copia este archivo: cp .env.example .env

# ── Entorno ──────────────────────────
APP_ENV=production

# ── Seguridad JWT ─────────────────────
# Genera tu clave: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIA-ESTO-POR-UNA-CLAVE-SEGURA
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Administrador inicial (init_db.py) ─
# Con este valor de ejemplo, o sin ADMIN_PASSWORD, init_db.py genera una
# contraseña aleatoria y la muestra una sola vez en la consola.
ADMIN_EMAIL=admin@tu-dominio.com
ADMIN_PASSWORD=CAMBIA-ESTA-CLAVE-DE-ADMIN

# ── Base de datos ─────────────────────
DATABASE_URL=sqlite:///./data/lung_detection.db

# ── Puertos ───────────────────────────
FRONTEND_PORT=80

# ── Dominio (solo para HTTPS) ─────────
DOMAIN=tu-dominio.com

# ── Almacenamiento ────────────────────
UPLOAD_DIR=/app/uploads
MODELS_DIR=/app/models
MAX_UPLOAD_SIZE_MB=50

# ── CORS ──────────────────────────────
ALLOWED_ORIGINS=https://tu-dominio.com,http://localhost:3000